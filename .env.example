# Database (Railway provides this automatically)
DATABASE_URL="postgresql://user:pass@host:5432/railway?sslmode=require"
PRISMA_DB_PUSH=true

# Telegram Bot
BOT_TOKEN="your_bot_token_from_botfather"
BOT_USERNAME="Zycot_Airdrop_bot"

# Admin Panel
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_strong_password"
SESSION_SECRET="super_secret_random_string_change_me"
JWT_SECRET="another_super_secret_jwt_key"

# Server
PORT=3000
NODE_ENV=production
WEBHOOK_DOMAIN=""   # Leave empty for polling, or set your railway domain for webhook
ADMIN_PATH="/admin" # Admin panel path
