<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Broadcast - Zycot Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <%- include('partials/nav') %>
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <h1 class="text-3xl font-bold text-yellow-400 mb-6">Broadcast Message</h1>
    
    <form method="POST" action="/admin/broadcast" class="bg-gray-800 rounded-xl p-6 border border-gray-700 mb-8">
      <label class="block text-sm text-gray-400 mb-2">Message (supports HTML)</label>
      <textarea name="message" rows="5" required class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded text-white" placeholder="Enter message to send to all users..."></textarea>
      <button type="submit" class="mt-4 bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-bold px-6 py-2 rounded">Create Broadcast</button>
      <p class="text-xs text-gray-500 mt-2">Note: Actual sending is handled by the bot process. After creating, the bot will pick it up.</p>
    </form>

    <h2 class="text-xl font-semibold mb-4">Recent Broadcasts</h2>
    <div class="space-y-3">
      <% broadcasts.forEach(b => { %>
        <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
          <div class="text-sm text-gray-400"><%= new Date(b.createdAt).toLocaleString() %> | Status: <%= b.status %></div>
          <div class="mt-2"><%= b.message.substring(0, 200) %><%= b.message.length > 200 ? '...' : '' %></div>
          <div class="text-xs text-gray-500 mt-1">Sent: <%= b.sentCount %> | Failed: <%= b.failedCount %></div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
