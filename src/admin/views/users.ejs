<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users - Zycot Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <%- include('partials/nav') %>
  <div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-yellow-400">Users (<%= total %>)</h1>
      <form class="flex gap-2">
        <input type="text" name="search" value="<%= search %>" placeholder="Search username, name, wallet..."
          class="px-4 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white w-64">
        <button type="submit" class="bg-yellow-500 text-gray-900 px-4 py-2 rounded-lg font-medium">Search</button>
      </form>
    </div>

    <div class="bg-gray-800 rounded-xl border border-gray-700 overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="text-gray-400 border-b border-gray-700">
            <th class="p-4">Telegram ID</th>
            <th class="p-4">Username</th>
            <th class="p-4">Name</th>
            <th class="p-4">Referrals</th>
            <th class="p-4">Wallet</th>
            <th class="p-4">Status</th>
            <th class="p-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr class="border-b border-gray-700/50 hover:bg-gray-750">
              <td class="p-4 text-sm"><%= u.telegramId.toString() %></td>
              <td class="p-4">@<%= u.username || '-' %></td>
              <td class="p-4"><%= u.firstName || '-' %></td>
              <td class="p-4"><%= u.referralCount %></td>
              <td class="p-4 text-xs font-mono max-w-xs truncate"><%= u.walletAddress || '-' %></td>
              <td class="p-4">
                <% if (u.isBanned) { %>
                  <span class="text-red-400">Banned</span>
                <% } else if (u.isVerified) { %>
                  <span class="text-green-400">Verified</span>
                <% } else { %>
                  <span class="text-yellow-400">Pending</span>
                <% } %>
              </td>
              <td class="p-4">
                <% if (u.isBanned) { %>
                  <form method="POST" action="/admin/users/<%= u.id %>/unban" class="inline">
                    <button class="text-green-400 hover:underline text-sm">Unban</button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/admin/users/<%= u.id %>/ban" class="inline">
                    <button class="text-red-400 hover:underline text-sm">Ban</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="flex justify-center gap-2 mt-6">
        <% for(let i=1; i<=totalPages; i++) { %>
          <a href="?page=<%= i %>&search=<%= search %>" 
             class="px-3 py-1 rounded <%= page===i ? 'bg-yellow-500 text-gray-900' : 'bg-gray-800 text-gray-300' %>">
            <%= i %>
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</body>
</html>
