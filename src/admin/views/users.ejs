<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users - Zycot Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <%- include('partials/nav') %>
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold text-yellow-400">Users (<%= total %>)</h1>
        <p class="text-gray-400 text-sm mt-1">All joined users — wallet, X profile & task status</p>
      </div>
      <form class="flex gap-2 w-full md:w-auto">
        <input type="text" name="search" value="<%= search %>" placeholder="Search username, name, wallet..."
          class="px-4 py-2 bg-gray-800 border border-gray-700 rounded-lg text-white flex-1 md:w-72">
        <button type="submit" class="bg-yellow-500 text-gray-900 px-4 py-2 rounded-lg font-medium">Search</button>
      </form>
    </div>

    <div class="bg-gray-800 rounded-xl border border-gray-700 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="text-gray-400 border-b border-gray-700">
            <th class="p-3">Telegram</th>
            <th class="p-3">Name</th>
            <th class="p-3">Referrals</th>
            <th class="p-3">Tasks</th>
            <th class="p-3">X Profile</th>
            <th class="p-3">Wallet (BEP-20)</th>
            <th class="p-3">Status</th>
            <th class="p-3">Joined</th>
            <th class="p-3">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length === 0) { %>
            <tr><td colspan="9" class="p-8 text-center text-gray-500">No users yet.</td></tr>
          <% } %>
          <% users.forEach(function(u) { %>
            <tr class="border-b border-gray-700/50 hover:bg-gray-750">
              <td class="p-3">
                <div class="font-medium">@<%= u.username || '-' %></div>
                <div class="text-xs text-gray-500"><%= u.telegramId.toString() %></div>
              </td>
              <td class="p-3"><%= u.firstName || '-' %></td>
              <td class="p-3 font-semibold text-blue-300"><%= u.referralCount %></td>
              <td class="p-3">
                <% if (u.tasksCompleted) { %>
                  <span class="text-green-400">✅ Done</span>
                <% } else { %>
                  <span class="text-yellow-400">⏳ Pending</span>
                <% } %>
              </td>
              <td class="p-3 max-w-[140px] truncate">
                <% if (u.xProfileLink) { %>
                  <a href="<%= u.xProfileLink %>" target="_blank" class="text-blue-400 hover:underline text-xs"><%= u.xProfileLink %></a>
                <% } else { %>
                  <span class="text-gray-500">-</span>
                <% } %>
              </td>
              <td class="p-3 font-mono text-xs max-w-[180px] truncate" title="<%= u.walletAddress || '' %>">
                <%= u.walletAddress || '-' %>
              </td>
              <td class="p-3">
                <% if (u.isBanned) { %>
                  <span class="text-red-400">Banned</span>
                <% } else if (u.isVerified && u.detailsSubmitted) { %>
                  <span class="text-green-400">Submitted</span>
                <% } else if (u.isVerified) { %>
                  <span class="text-green-400">Verified</span>
                <% } else { %>
                  <span class="text-yellow-400">Pending</span>
                <% } %>
              </td>
              <td class="p-3 text-xs text-gray-400"><%= new Date(u.createdAt).toLocaleDateString() %></td>
              <td class="p-3">
                <% if (u.isBanned) { %>
                  <form method="POST" action="/admin/users/<%= u.id %>/unban" class="inline">
                    <button class="text-green-400 hover:underline text-sm">Unban</button>
                  </form>
                <% } else { %>
                  <form method="POST" action="/admin/users/<%= u.id %>/ban" class="inline">
                    <button class="text-red-400 hover:underline text-sm">Ban</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="flex justify-center gap-2 mt-6 flex-wrap">
        <% for(var i=1; i<=totalPages; i++) { %>
          <a href="?page=<%= i %>&search=<%= search %>"
             class="px-3 py-1 rounded <%= page===i ? 'bg-yellow-500 text-gray-900' : 'bg-gray-800 text-gray-300' %>">
            <%= i %>
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</body>
</html>
