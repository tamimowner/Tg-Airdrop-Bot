<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tasks - Zycot Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <%- include('partials/nav') %>
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-yellow-400 mb-6">Task Management</h1>

    <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 mb-8">
      <h2 class="text-xl font-semibold mb-4">Add New Task</h2>
      <form method="POST" action="/admin/tasks" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm text-gray-400 mb-1">Title</label>
          <input name="title" required class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded text-white">
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Type</label>
          <select name="type" class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded text-white">
            <option value="JOIN_CHANNEL">Join Channel</option>
            <option value="JOIN_GROUP">Join Group</option>
            <option value="FOLLOW_X">Follow X/Twitter</option>
            <option value="LIKE_RETWEET">Like & Retweet</option>
            <option value="CUSTOM">Custom</option>
          </select>
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Link (optional)</label>
          <input name="link" class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded text-white">
        </div>
        <div>
          <label class="block text-sm text-gray-400 mb-1">Order</label>
          <input name="order" type="number" value="0" class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded text-white">
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm text-gray-400 mb-1">Description</label>
          <textarea name="description" rows="2" class="w-full px-3 py-2 bg-gray-700 border border-gray-600 rounded text-white"></textarea>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" name="isRequired" id="isRequired" checked>
          <label for="isRequired">Required Task</label>
        </div>
        <div>
          <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-bold px-6 py-2 rounded">Add Task</button>
        </div>
      </form>
    </div>

    <div class="bg-gray-800 rounded-xl border border-gray-700 overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="text-gray-400 border-b border-gray-700">
            <th class="p-4">Order</th>
            <th class="p-4">Title</th>
            <th class="p-4">Type</th>
            <th class="p-4">Link</th>
            <th class="p-4">Active</th>
            <th class="p-4">Required</th>
            <th class="p-4">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% tasks.forEach(t => { %>
            <tr class="border-b border-gray-700/50">
              <td class="p-4"><%= t.order %></td>
              <td class="p-4"><%= t.title %></td>
              <td class="p-4"><span class="text-xs bg-gray-700 px-2 py-1 rounded"><%= t.type %></span></td>
              <td class="p-4 text-sm max-w-xs truncate"><%= t.link || '-' %></td>
              <td class="p-4"><%= t.isActive ? '✅' : '❌' %></td>
              <td class="p-4"><%= t.isRequired ? 'Yes' : 'No' %></td>
              <td class="p-4 space-x-2">
                <form method="POST" action="/admin/tasks/<%= t.id %>/toggle" class="inline">
                  <button class="text-blue-400 text-sm hover:underline"><%= t.isActive ? 'Disable' : 'Enable' %></button>
                </form>
                <form method="POST" action="/admin/tasks/<%= t.id %>/delete" class="inline" onsubmit="return confirm('Delete?')">
                  <button class="text-red-400 text-sm hover:underline">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
