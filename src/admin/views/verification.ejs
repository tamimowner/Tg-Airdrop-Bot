<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verification Queue - Zycot Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <%- include('partials/nav') %>
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-yellow-400 mb-6">Verification Queue</h1>
    <div class="space-y-4">
      <% if (submissions.length === 0) { %>
        <div class="bg-gray-800 rounded-xl p-8 text-center text-gray-400">No pending submissions</div>
      <% } %>
      <% submissions.forEach(s => { %>
        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="font-semibold">@<%= s.user.username || s.user.telegramId %> - <%= s.task.title %></div>
            <div class="text-sm text-gray-400 mt-1">Type: <%= s.task.type %> | Submitted: <%= new Date(s.createdAt).toLocaleString() %></div>
            <% if (s.proof) { %>
              <div class="text-sm mt-2 text-blue-400 break-all"><%= s.proof %></div>
            <% } %>
            <% if (s.user.xProfileLink) { %>
              <div class="text-sm mt-1">X: <a href="<%= s.user.xProfileLink %>" target="_blank" class="text-blue-400"><%= s.user.xProfileLink %></a></div>
            <% } %>
          </div>
          <div class="flex gap-2">
            <form method="POST" action="/admin/verification/<%= s.id %>/approve">
              <button class="bg-green-600 hover:bg-green-700 px-4 py-2 rounded text-sm">Approve</button>
            </form>
            <form method="POST" action="/admin/verification/<%= s.id %>/reject">
              <button class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded text-sm">Reject</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
